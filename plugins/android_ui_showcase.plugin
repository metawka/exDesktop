"""
Android UI Showcase Plugin for exDesktop
Demonstrates using Android UI components on Desktop:
- LinearLayout, TextView, EditText, ScrollView, LayoutHelper
- Custom View with onDraw & Canvas rendering (Rect, RoundRect, Paint)
- AlertDialog.Builder & BottomSheet with custom Android view hierarchy
- Xposed hooking on ChatMessageCell.onDraw for custom message styling
- Chat Action Menu & Message Context Menu integration
"""

_IS_MAIN = (__name__ == "__main__")

__id__ = "android_ui_showcase"
__name__ = "Android UI Showcase"
__description__ = "Demonstrates Android UI components (Layout, Widgets, Canvas, Dialogs) on Desktop"
__author__ = "exDesktop Team"
__version__ = "1.0.0"
__min_version__ = "1.0.0"

import sys
import os

# Ensure local imports work when running standalone or in development
_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
_REPO_ROOT = os.path.dirname(_THIS_DIR)
_EXTERA_PY = os.path.join(_REPO_ROOT, "Telegram", "SourceFiles", "extera", "python")
if _EXTERA_PY not in sys.path:
    sys.path.insert(0, _EXTERA_PY)

try:
    import _extera
except ImportError:
    import types
    _mock_ext = types.ModuleType("_extera")
    _mock_ext.log = lambda m: print(f"[_extera.log] {m}")
    _mock_ext.call_native = lambda *a: None
    _mock_ext.settings_changed = lambda *a: None
    _mock_ext.run_on_main = lambda fn, *a: fn()
    sys.modules["_extera"] = _mock_ext
    _extera = _mock_ext

import _compat
_compat.install()

from base_plugin import BasePlugin, MenuItemType, MenuItemData, MethodHook
from android_views import (
    View, ViewGroup, LinearLayout, FrameLayout, TextView, EditText, ScrollView,
    LayoutHelper, AlertDialog, BottomSheet, Canvas, Paint, RectF,
    ChatMessageCell, dp
)
from android.graphics import Color
from de.robv.android.xposed import XposedBridge, XC_MethodHook
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
import ui.bulletin as bulletin
import ui.settings as settings


class CanvasCustomBadge(View):
    """
    Custom Android View rendering a graphic badge via Canvas and Paint
    with geometry translation to Desktop coordinates.
    """
    def __init__(self, title="Android on Desktop", subtitle="Native QPainter Pipeline"):
        super().__init__()
        self.title = title
        self.subtitle = subtitle
        w = int(dp(340))
        h = int(dp(74))
        self.setMeasuredDimension(w, h)
        self._left = 0
        self._top = 0
        self._right = w
        self._bottom = h

    def onMeasure(self, width_spec, height_spec):
        self.setMeasuredDimension(int(dp(340)), int(dp(74)))

    def onDraw(self, canvas):
        super().onDraw(canvas)
        w = float(self.getWidth() or int(dp(340)))
        h = float(self.getHeight() or int(dp(74)))

        # 1. Background plate with rounded corners and border stroke
        bg_paint = Paint()
        bg_paint.setColor(0xFF1E293B)  # Slate 800 background
        canvas.drawRoundRect(RectF(0, 0, w, h), float(dp(12)), float(dp(12)), bg_paint)

        stroke_paint = Paint()
        stroke_paint.setStyle(Paint.Style.STROKE)
        stroke_paint.setColor(0x4038BDF8)  # Semi-transparent border
        stroke_paint.setStrokeWidth(float(dp(1.5)))
        canvas.drawRoundRect(RectF(0, 0, w, h), float(dp(12)), float(dp(12)), stroke_paint)

        # 2. Accent side stripe
        accent_paint = Paint()
        accent_paint.setColor(0xFF38BDF8)  # Sky blue
        canvas.drawRoundRect(RectF(float(dp(4)), float(dp(8)), float(dp(10)), h - float(dp(8))), float(dp(3)), float(dp(3)), accent_paint)

        # 3. Header title text
        text_paint = Paint()
        text_paint.setColor(0xFFFFFFFF)
        text_paint.setTextSize(float(dp(15)))
        text_paint.setBold(True)
        canvas.drawText(self.title, float(dp(22)), float(dp(28)), text_paint)

        # 4. Subtitle text
        sub_paint = Paint()
        sub_paint.setColor(0xFF94A3B8)
        sub_paint.setTextSize(float(dp(12)))
        canvas.drawText(self.subtitle, float(dp(22)), float(dp(52)), sub_paint)


class AndroidUiShowcasePlugin(BasePlugin):
    """Plugin demonstrating Android UI components on Desktop."""

    def on_plugin_load(self):
        self.log("AndroidUiShowcasePlugin loaded successfully")

        # 1. Action button in chat header to open Android Dialog
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="📱 Open Android UI",
            icon="menu_plugins",
            on_click=self.on_chat_action_click,
            item_id="android_ui_chat_action",
            priority=100
        ))

        # 2. Context menu item for messages
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="🎨 Message Card (Android UI)",
            icon="menu_info",
            on_click=self.on_message_menu_click,
            item_id="android_ui_msg_context",
            priority=50
        ))

        # 3. Hook ChatMessageCell.onDraw via Xposed
        self.setup_chat_cell_hook()

    def setup_chat_cell_hook(self):
        """Installs Xposed hook on ChatMessageCell.onDraw."""
        class CellDrawHook(XC_MethodHook):
            def afterHookedMethod(this_hook, param):
                # Check plugin setting
                if not this_hook.plugin.get_setting("badge_enabled", True):
                    return
                canvas = param.args[0]
                cell = param.thisObject

                # Draw indicator badge on message cell
                p = Paint()
                p.setColor(0xFF007ACC)
                badge_w = float(dp(54))
                badge_h = float(dp(16))
                right = float(cell.getWidth() or 200) - float(dp(8))
                left = right - badge_w
                top = float(dp(4))
                bottom = top + badge_h

                canvas.drawRoundRect(RectF(left, top, right, bottom), float(dp(4)), float(dp(4)), p)

                # Badge text
                tp = Paint()
                tp.setColor(0xFFFFFFFF)
                tp.setTextSize(float(dp(10)))
                canvas.drawText("EXD-UI", left + float(dp(7)), top + float(dp(12)), tp)

        CellDrawHook.plugin = self
        m_draw = ChatMessageCell.getMethod("onDraw")
        XposedBridge.hookMethod(m_draw, CellDrawHook())

    def create_settings(self):
        """Settings UI for plugin."""
        return [
            settings.Header("Android UI Integration"),
            settings.Switch(
                key="badge_enabled",
                default=True,
                title="Display badge in message cells",
                subtitle="ChatMessageCell.onDraw hook renders 'EXD-UI' indicator via Android Canvas"
            ),
            settings.Divider(),
            settings.Text(
                title="About Components",
                subtitle="Plugin utilizes LayoutHelper, LinearLayout, TextView, EditText and AlertDialog from Android packages."
            )
        ]

    def on_chat_action_click(self, event):
        """Opens native Material dialog for Android UI."""
        self.open_android_dialog(title="Android UI on Desktop")

    def on_message_menu_click(self, event):
        """Opens dialog with message info in Android View."""
        msg_id = event.get("id") or event.get("msg_id") or "1"
        self.open_android_dialog(
            title=f"Message #{msg_id}",
            initial_text=f"Selected message ID: {msg_id}"
        )

    def open_android_dialog(self, title="Android Subsystem", initial_text=""):
        """
        Opens native Material dialog in Telegram Desktop with system components.
        """
        builder = AlertDialogBuilder(None)
        builder.set_title("📱 " + str(title))
        builder.set_message("Native exDesktop dialog using official Material components:")

        items = [
            "🔔 Show native Material Toast (Bulletin)",
            "🎨 Toggle Xposed message badge (ChatMessageCell)",
            "📐 Verify geometry status (MeasureSpec & onMeasure)",
            "⚙ Open plugin settings"
        ]

        def on_item_click(dialog, which):
            if which == 0:
                BulletinHelper.show_success("Native Material Bulletin is active!")
                self.log("Bulletin toast displayed")
            elif which == 1:
                cur = self.get_setting("badge_enabled", True)
                self.set_setting("badge_enabled", not cur)
                state = "enabled" if not cur else "disabled"
                BulletinHelper.show_info(f"Cell hook {state}")
                self.log(f"Badge hook status: {state}")
            elif which == 2:
                BulletinHelper.show_info("MeasureSpec & Geometry: 100% native")
                self.log("Geometry verification completed")
            elif which == 3:
                try:
                    _extera.open_plugin_settings(self.id)
                except Exception:
                    pass

        builder.set_items(items, on_item_click)
        builder.set_positive_button("Close", lambda d, which: d.dismiss() if hasattr(d, "dismiss") else None)
        builder.show()
        self.log("Native Material dialog displayed")


if _IS_MAIN:
    print("=== Self-test Android UI Showcase ===")
    plugin = AndroidUiShowcasePlugin()
    plugin.on_plugin_load()

    # Verify View tree creation
    root = LinearLayout()
    root.setOrientation(LinearLayout.VERTICAL)
    t = TextView()
    t.setText("Test Title")
    root.addView(t)
    e = EditText()
    e.setText("Hello")
    root.addView(e)
    badge = CanvasCustomBadge()
    root.addView(badge)

    root.measure(
        ViewGroup.MeasureSpec.makeMeasureSpec(300, ViewGroup.MeasureSpec.EXACTLY),
        ViewGroup.MeasureSpec.makeMeasureSpec(200, ViewGroup.MeasureSpec.EXACTLY)
    )
    root.layout(0, 0, 300, 200)

    # Verify Canvas rendering
    from android_views import Bitmap
    bmp = Bitmap(320, 70)
    canvas = Canvas(bmp)
    badge.draw(canvas)
    ops = [op["op"] for op in bmp.ops]
    assert "rrect" in ops, f"Expected rrect in ops: {ops}"
    assert "text" in ops, f"Expected text in ops: {ops}"

    print("Android UI view tree and Canvas rendering verified successfully!")
    print("ALL TESTS PASSED!")
