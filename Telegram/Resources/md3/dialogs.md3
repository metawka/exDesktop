dialogsFilter: InputField(dialogsFilter) {
	textMargins: margins(38px, 8px, 30px, 5px);
}
dialogRowOpenBot: DialogRightButton(dialogRowOpenBot) {
	margin: margins(0px, 32px, 22px, 0px);
}
